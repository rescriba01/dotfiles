        ".github/instructions": true,
        ".claude/rules": true,
        "~/.copilot/instructions": true,
        "~/.claude/rules": true,
        "/var/folders/km/gzcvrpf52dnfcg9cchzbn80m0000gp/T/postman-collections-post-response.instructions.md": true,
        "/var/folders/km/gzcvrpf52dnfcg9cchzbn80m0000gp/T/postman-collections-pre-request.instructions.md": true,
