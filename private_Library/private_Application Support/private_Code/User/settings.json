{
    "copilot.chat.enabledLanguages": [
        "shellscript, shellscript (bash), shell, powershell, bash, sh",
    ],
    "workbench.iconTheme": "material-icon-theme",
    "terminal.integrated.fontSize": 15,
    "editor.linkedEditing": true,
    "editor.accessibilitySupport": "off",
    "css.format.newlineBetweenRules": true,
    "css.format.newlineBetweenSelectors": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.fontFamily": "'JetBrains Mono', Fira Code, Menlo, monospace",
    "editor.fontSize": 16,
    "editor.fontLigatures": true,
    "editor.wordWrap": "on",
    "editor.detectIndentation": false,
    "editor.insertSpaces": true,
    "editor.tabSize": 4,
    "prettier.useTabs": false,
    "prettier.tabWidth": 4,
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": "active",
    "files.autoSave": "afterDelay",
    "eslint.format.enable": false,
    "eslint.lintTask.enable": true,
    "workbench.colorTheme": "An Old Hope",
    "editor.formatOnSave": true,
    "prettier.jsxSingleQuote": true,
    "prettier.htmlWhitespaceSensitivity": "css",
    "prettier.singleAttributePerLine": false,
    "emmet.syntaxProfiles": {
        "javascript": "jsx",
        "xml": {
            "attr_quotes": "single",
        },
    },
    "emmet.includeLanguages": {
        "javascript": "javascriptreact",
        "css": "css",
    },
    // Emmet: stop abbreviation matches from cluttering the suggestion list
    "emmet.showAbbreviationSuggestions": false,
    "prettier.singleQuote": false,
    "javascript.format.insertSpaceAfterOpeningAndBeforeClosingNonemptyParenthesis": true,
    "liveServer.settings.donotShowInfoMsg": true,
    "terminal.external.osxExec": "iTerm.app",
    "workbench.colorCustomizations": {
        "[Material Theme Ocean]": {},
    },
    "bracket-pair-colorizer-2.colors": ["Gold", "Orchid", "LightSkyBlue"],
    "bracket-pair-colorizer-2.excludedLanguages": [],
    "redhat.telemetry.enabled": true,
    "html-css-class-completion.enableEmmetSupport": true,
    "css.validate": false,
    "less.validate": false,
    "scss.validate": false,
    // PHPCS
    "phpcs.enable": true,
    "phpcs.standard": "WordPress",
    "phpcs.showWarnings": true,
    "liveServer.settings.donotVerifyTags": true,
    "javascript.suggest.paths": false,
    "typescript.suggest.paths": false,
    "todo-tree.general.tags": [
        "BUG",
        "HACK",
        "FIXME",
        "TODO",
        "XXX",
        "[ ]",
        "[x]",
    ],
    "todo-tree.regex.regex": "(//|#|<!--|;|/\\*|^|^\\s*(-|\\d+.))\\s*($TAGS)",
    "liveSassCompile.settings.excludeList": [
        "**/node_modules/**",
        ".vscode/**",
        "**/wp-content/plugins/**",
    ],
    "liveSassCompile.settings.formats": [
        {
            "format": "compressed",
            "extensionName": ".css",
            "savePath": "~/../css/",
        },
    ],
    "vscode-edge-devtools.headless": true,
    "vscode-edge-devtools.mirrorEdits": true,
    "files.associations": {
        "*.css": "css",
    },
    "material-icon-theme.activeIconPack": "react",
    "emmet.triggerExpansionOnTab": true,
    "html.format.indentHandlebars": true,
    "html.format.indentInnerHtml": true,
    "editor.inlineSuggest.enabled": true,
    "atlascode.bitbucket.enabled": false,
    "security.workspace.trust.untrustedFiles": "open",
    "workbench.startupEditor": "none",
    "css.enabledLanguages": [[]],
    "eslint.codeActionsOnSave.rules": null,
