    "chat.mcp.gallery.enabled": true,
    "[html]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "chat.viewSessions.orientation": "stacked",
    "editor.snippetSuggestions": "top",

    // --- Snippet workflow tweaks (from the Email Editing Tools extension's guide) ---
    // Tab only expands a matched snippet prefix; doesn't fight with plain indentation.
    // Watch this against editor.inlineSuggest.enabled + emmet.triggerExpansionOnTab —
    // if Tab ever does something unexpected, this is the setting to revisit first.
    "editor.tabCompletion": "onlySnippets",

    // --- Requires the "Snippets Viewer" extension (RandomFractals.snippets-viewer) ---
    // These four are no-ops until that extension is installed.
    // skipLanguageSnippets trimmed from the article's version to NOT hide
    // php/javascript/typescript, since you use those daily.
    "snippets.viewer.expandSnippetFiles": true,
    "snippets.viewer.focusOnActiveEditorSnippets": true,
    "snippets.viewer.showOnlyActiveEditorLanguageSnippets": true,
    "snippets.viewer.skipLanguageSnippets": "vb,swift,fsharp,csharp,cpp,c,coffeescript,bat,groovy",
    "snippets.viewer.sortSnippetsByName": false,
    "window.newWindowProfile": "Default",
}
