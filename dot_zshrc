# Path to your oh-my-zsh installation and theme settings
export ZSH=$HOME/.oh-my-zsh
export ZSH_THEME=""
export DEFAULT_USER="$(whoami)"

# Machine-type config. chezmoi deploys only this machine's directory:
#   ~/.config/zsh/personal/  or  ~/.config/zsh/work/
# env.zsh (PATH and environment) loads here; aliases.zsh loads after oh-my-zsh.
for _dir in ~/.config/zsh/personal ~/.config/zsh/work; do
  [[ -d $_dir ]] && ZSH_MACHINE_DIR=$_dir && break
done
unset _dir
[[ -f $ZSH_MACHINE_DIR/env.zsh ]] && source $ZSH_MACHINE_DIR/env.zsh

# Default Editor
export EDITOR=nvim

# Source nvm command for terminal
if [ -s "$HOME/.nvm/nvm.sh" ]; then
  source "$HOME/.nvm/nvm.sh"
fi

# Specify which plugins you want to use (env.zsh can add extra_omz_plugins)
plugins=(
  zsh-autosuggestions
  zsh-syntax-highlighting
  $extra_omz_plugins
)

# Fix Errors
ZSH_DISABLE_COMPFIX="true"

# Load oh-my-zsh and its plugins
if [ -s "$ZSH/oh-my-zsh.sh" ]; then
  source $ZSH/oh-my-zsh.sh
fi

#######################
# Aliases and Functions
#######################

# Open zshrc in LazyVim
alias lazyzsh="nvim ~/.zshrc"

# Directory Navigation
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."

# Always use lsd instead of ls
alias ls='lsd -lAFh'

# This machine type's aliases and functions
[[ -f $ZSH_MACHINE_DIR/aliases.zsh ]] && source $ZSH_MACHINE_DIR/aliases.zsh

#######################
# Theme Configuration
#######################

# Starship Theme
eval "$(starship init zsh)"

# Machine-specific settings that don't belong in the public dotfiles repo
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local

# Drop duplicate PATH entries, keeping the first occurrence. Must stay last:
# `export PATH=...` (used above and by nvm/Volta) bypasses the uniqueness flag.
typeset -U path
