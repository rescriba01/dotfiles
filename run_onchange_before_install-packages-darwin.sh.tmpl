{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# Package lists live in .chezmoidata/packages.yaml; this re-runs when they change.

# Install Homebrew if not present
if ! command -v brew &> /dev/null; then
    echo "Installing Homebrew..."
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

{{ $sets := list .packages.darwin.common (index .packages.darwin .machineType) -}}
{{ $vscode := concat .packages.vscode.common (index .packages.vscode .machineType) -}}
# Install packages using brew bundle ({{ .machineType }} machine)
# --no-upgrade: install what's missing, never upgrade what's there (run
# `brew upgrade` deliberately). On Intel Macs Homebrew no longer ships bottles,
# so an upgrade means compiling from source.
brew bundle --no-upgrade --file=/dev/stdin <<BREWFILE
{{ range $sets }}{{ range .taps }}tap {{ . | quote }}
{{ end }}{{ end -}}
{{ range $sets }}{{ range .brews }}brew {{ . | quote }}
{{ end }}{{ range .brews_unlinked }}brew {{ . | quote }}, link: false
{{ end }}{{ end -}}
{{ range $sets }}{{ range .casks }}cask {{ . | quote }}
{{ end }}{{ end -}}
{{ range $sets }}{{ range .mas }}mas {{ .name | quote }}, id: {{ .id }}
{{ end }}{{ end -}}
{{ range $vscode }}vscode {{ . | quote }}
{{ end -}}
BREWFILE
{{ end -}}
