#!/bin/bash
# Blocks commits to this (public) dotfiles repo that contain secrets.
# Covers manual commits and the ones chezmoi-sync makes.
hook="{{ .chezmoi.sourceDir }}/.git/hooks/pre-commit"
cat >"$hook" <<'HOOK'
#!/bin/bash
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
if ! command -v gitleaks >/dev/null; then
  echo "pre-commit: gitleaks not installed; refusing to commit to a public repo" >&2
  exit 1
fi
exec gitleaks git --pre-commit --staged --redact --no-banner
HOOK
chmod +x "$hook"
