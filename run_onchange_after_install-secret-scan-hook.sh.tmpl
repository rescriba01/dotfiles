#!/bin/bash
# Blocks commits to this (public) dotfiles repo that contain secrets.
# Covers manual commits and the ones chezmoi-sync makes.
hook="{{ .chezmoi.sourceDir }}/.git/hooks/pre-commit"
cat >"$hook" <<'HOOK'
#!/bin/bash
export PATH="$HOME/bin:/opt/homebrew/bin:/usr/local/bin:$HOME/.homebrew/bin:$PATH"
if ! command -v betterleaks >/dev/null; then
  echo "pre-commit: betterleaks not installed; refusing to commit to a public repo" >&2
  exit 1
fi
exec betterleaks git --pre-commit --staged --redact
HOOK
chmod +x "$hook"
